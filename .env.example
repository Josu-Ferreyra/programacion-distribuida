# --- HTTPS de la API externa (certificados autofirmados locales, NO versionar)
SSL_KEY_PATH=certs/key.pem
SSL_CERT_PATH=certs/cert.pem

# --- Redis/Memurai: SÓLO para el lock distribuido de ahorros (TP2).
# Los tres nodos deben apuntar a la MISMA instancia.
REDIS_URL=redis://localhost:6379

# --- Persistencia independiente por nodo (negocio + estado Raft)
MONGO_URI_NODE_1=mongodb://localhost:27017/tp4_node1
MONGO_URI_NODE_2=mongodb://localhost:27017/tp4_node2
MONGO_URI_NODE_3=mongodb://localhost:27017/tp4_node3

# --- Puertos (opcional; por defecto API 3001-3003 y RPC Raft 4001-4003)
# API_PORT_NODE_1=3001
# API_PORT_NODE_2=3002
# API_PORT_NODE_3=3003
# RAFT_PORT_NODE_1=4001
# RAFT_PORT_NODE_2=4002
# RAFT_PORT_NODE_3=4003
# CLUSTER_API_HOST=localhost
# CLUSTER_RAFT_HOST=127.0.0.1
# RAFT_BIND_HOST=127.0.0.1

# --- Tiempos del protocolo (ms). Valores lentos a propósito para poder observarlo.
RAFT_ELECTION_TIMEOUT_MIN_MS=1500
RAFT_ELECTION_TIMEOUT_MAX_MS=3000
RAFT_HEARTBEAT_INTERVAL_MS=500
RAFT_RPC_TIMEOUT_MS=300
RAFT_COMMIT_TIMEOUT_MS=5000
RAFT_MAX_ENTRIES_PER_RPC=50

# --- Lock de ahorros (integración Redis + Raft)
SAVINGS_LOCK_TTL_MS=10000
# Retardo artificial dentro de la sección crítica para observar la exclusión mutua
SAVINGS_CRITICAL_SECTION_DELAY_MS=1000

# --- Logging: debug muestra también cada heartbeat
LOG_LEVEL=info
